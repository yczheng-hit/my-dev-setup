{
  "version": 1,
  "actionFusion": false,
  "observationPack": true,
  "evidencePreservingReducer": false,
  "onlineContextCompact": true,
  "cacheWriteReadRatio": 12.5,
  "liveCompact": {
    "enabled": true,
    "strategy": "dynamic-ai",
    "thresholds": {
      "startRatio": 0.7,
      "targetRatio": 0.5,
      "ceilingRatio": 0.8
    },
    "protection": {
      "keepRecentToolRounds": 3,
      "minFullRequests": 2
    },
    "observation": {
      "minBytes": 10240,
      "excerptTargetBytes": 8192
    },
    "summary": {
      "provider": "nvidia-inference",
      "model": "azure/openai/eccn-gpt-6.1-terra"
    },
    "verification": {
      "provider": "nvidia-inference",
      "model": "azure/openai/eccn-gpt-6.1-terra"
    }
  }
}
