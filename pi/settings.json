{
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "externalEditor": "vi",
  "modelThinkingLevels": {
    "openai-codex/gpt-6.1-sol": "xhigh"
  },
  "enabledModels": [
    "anthropic/claude-opus-5-5",
    "anthropic/claude-fable-5-1",
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-haiku-5-5",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6.1-sol"
  ],
  "packages": [
    "repo:packages/pi-agent-summary-time",
    "repo:packages/pi-fork-save",
    "npm:pi-cc-extensions",
    "repo:packages/picc-permission-modes",
    "repo:packages/pi-openai-codex-compat",
    "repo:packages/pi-gpt-codex",
    { "source": "npm:pi-subagents", "extensions": [] },
    "repo:packages/pi-subagents-herdr-labels",
    "npm:@mrclrchtr/supi-review",
    "npm:pi-omp-advisor",
    "npm:pi-hashline-edit-pro",
    "npm:pi-repl-py",
    "npm:pi-context",
    "repo:packages/pi-scheduler",
    "npm:@narumitw/pi-goal",
    "repo:tools/pi-btw-split",
    "npm:pi-web-access",
    "npm:pi-sticky-last-prompt",
    "repo:packages/pi-hud-footer",
    "repo:packages/pi-subagent-hud",
    "git:github.com/panbergco/pi-cc-steer"
  ],
  "hideThinkingBlock": true,
  "theme": "claude-dark",
  "showHardwareCursor": true,
  "terminal": {
    "showTerminalProgress": true
  },
  "markdown": {
    "mermaid": "final"
  },
  "warnings": {
    "anthropicExtraUsage": true
  }
}
