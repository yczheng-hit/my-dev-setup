{
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "externalEditor": "vi",
  "enabledModels": [
    "nvidia-inference/azure/openai/eccn-gpt-6.1-terra",
    "local/opus",
    "local/sonnet",
    "local/haiku",
    "nvidia-inference/openai/openai/eccn-gpt-6-astra",
    "nvidia-inference/openai/openai/eccn-gpt-6-sol",
    "nvidia-inference/openai/openai/eccn-gpt-6.1-sol",
    "nvidia-inference/us/azure/openai/eccn-gpt-5.6-sol",
    "nvidia-inference/azure/openai/eccn-gpt-6.1-sol",
    "nvidia-inference/nvidia/deepseek-ai/eccn-deepseek-v4.1-flash-1017",
    "nvidia-inference/nvidia/zai-org/eccn-glm-5.3",
    "nvidia-inference/nvidia/nvidia/eccn-nemotron-3-ultra",
    "nvidia-inference/gcp/google/eccn-gemini-4-argon",
    "nvidia-inference/xai/xai/eccn-grok-4.7"
  ],
  "packages": [
    "repo:packages/pi-agents-context",
    "repo:packages/pi-agent-summary-time",
    "repo:packages/pi-compaction-guidance",
    "repo:packages/pi-fork-save",
    "npm:pi-cc-extensions",
    "repo:packages/picc-permission-modes",
    "repo:packages/pi-openai-codex-compat",
    "repo:packages/pi-gpt-codex",
    { "source": "npm:pi-subagents", "extensions": [] },
    "repo:packages/pi-subagents-herdr-labels",
    "npm:@mrclrchtr/supi-review",
    "npm:pi-omp-advisor",
    "npm:pi-hashline-edit-pro",
    "npm:pi-repl-py",
    "npm:pi-context",
    "repo:packages/pi-scheduler",
    "npm:@narumitw/pi-goal",
    "repo:tools/pi-btw-split",
    "npm:pi-web-access",
    "npm:pi-sticky-last-prompt",
    "repo:packages/pi-hud-footer",
    "repo:packages/pi-subagent-hud",
    "git:github.com/panbergco/pi-cc-steer",
    "git:github.com/yczheng-hit/pi-ambient-compact"
