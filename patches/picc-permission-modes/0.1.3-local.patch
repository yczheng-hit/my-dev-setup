+      plan: "plan",
+      bypasspermissions: "bypassPermissions",
+      "bypass-permissions": "bypassPermissions",
+      bypass: "bypassPermissions",
+      auto: "auto",
+    };
+    return modes[value.trim().toLowerCase()] ?? "default";
+  } catch {
+    return "default";
+  }
